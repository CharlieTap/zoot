+}
+
+static void ApplyDeterministicInput(OSContPad* pad) {
+    const char* script = std::getenv("OOT_FAST3D_INPUT_SCRIPT");
+    if (!UseDeterministicReferenceTime() || script == nullptr) {
+        return;
+    }
+    const uint64_t inputFrame = sReferenceInputFrame++;
+    while (*script != '\0') {
+        unsigned long long first = 0;
+        unsigned long long last = 0;
+        unsigned buttons = 0;
+        int stickX = 0;
+        int stickY = 0;
+        int consumed = 0;
+        if (std::sscanf(script, "%llu-%llu:%x:%d:%d%n", &first, &last, &buttons, &stickX, &stickY, &consumed) !=
+            5) {
+            return;
+        }
+        if (inputFrame >= first && inputFrame <= last) {
+            pad[0].button = static_cast<uint16_t>(buttons);
+            pad[0].stick_x = static_cast<int8_t>(stickX);
+            pad[0].stick_y = static_cast<int8_t>(stickY);
+            return;
+        }
+        const char* next = std::strchr(script + consumed, ';');
+        if (next == nullptr) {
+            return;
+        }
+        script = next + 1;
+    }
+}
