diff --git a/libultraship/src/fast/reference_trace.cpp b/libultraship/src/fast/reference_trace.cpp
new file mode 100644
index 0000000..98b5e1d
--- /dev/null
+++ b/libultraship/src/fast/reference_trace.cpp
@@ -0,0 +1,313 @@
+#include "fast/reference_trace.h"
+
+#include <algorithm>
+#include <bit>
+#include <cerrno>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+
+#include "fast/backends/gfx_rendering_api.h"
+#include "fast/interpreter.h"
+
+namespace Fast {
+namespace {
+
+constexpr size_t DefaultMaximumEvents = 500000;
+
+uint32_t PackColor(const RGBA& color) {
+    return (static_cast<uint32_t>(color.r) << 24) | (static_cast<uint32_t>(color.g) << 16) |
+           (static_cast<uint32_t>(color.b) << 8) | color.a;
+}
+
+long ReadLong(const char* name, long fallback) {
+    const char* value = std::getenv(name);
+    if (value == nullptr || *value == '\0') {
+        return fallback;
+    }
+    char* end = nullptr;
+    errno = 0;
+    long parsed = std::strtol(value, &end, 10);
+    return errno == 0 && end != value && *end == '\0' ? parsed : fallback;
+}
+
+class Writer {
+  public:
+    Writer() {
+        const char* path = std::getenv("OOT_FAST3D_TRACE");
+        if (path == nullptr || *path == '\0') {
+            return;
+        }
+        mFile = std::fopen(path, "wb");
+        if (mFile == nullptr) {
+            std::fprintf(stderr, "Unable to open OOT_FAST3D_TRACE '%s': %s\n", path, std::strerror(errno));
+            return;
+        }
+        mFirstFrame = std::max(0L, ReadLong("OOT_FAST3D_TRACE_FRAME", 0));
+        mFrameCount = std::max(1L, ReadLong("OOT_FAST3D_TRACE_FRAMES", 1));
+        mMaximumEvents = static_cast<size_t>(std::max(1L, ReadLong("OOT_FAST3D_TRACE_MAX_EVENTS", DefaultMaximumEvents)));
+        mExitWhenComplete = ReadLong("OOT_FAST3D_CAPTURE_EXIT", 0) != 0;
+        const char* colorPath = std::getenv("OOT_FAST3D_COLOR_CAPTURE");
+        if (colorPath != nullptr) {
+            mColorPath = colorPath;
+        }
+        const char* depthPath = std::getenv("OOT_FAST3D_DEPTH_CAPTURE");
+        if (depthPath != nullptr) {
+            mDepthPath = depthPath;
+        }
+    }
+
+    ~Writer() {
+        if (mFile != nullptr) {
+            std::fclose(mFile);
+        }
+    }
+
+    bool active() const {
+        return mActive && !mOverflowed;
+    }
+
+    int commandIndex() const {
+        return mCommandIndex;
+    }
+
+    void beginRun(float interpolation, int interpolationIndex) {
+        mActive = mFile != nullptr && mRunIndex >= mFirstFrame && mRunIndex < mFirstFrame + mFrameCount;
+        mCommandIndex = -1;
+        mEvents = 0;
+        mOverflowed = false;
+        if (mActive) {
+            line("fast3d-reference-trace|1|%ld|%08x|%d\n", mRunIndex, std::bit_cast<uint32_t>(interpolation),
+                 interpolationIndex);
+        }
+    }
+
+    void endRun() {
+        const bool completedCapture = mActive && mRunIndex + 1 >= mFirstFrame + mFrameCount;
+        if (mActive && mFile != nullptr) {
+            std::fprintf(mFile, "end|%ld|%zu|%d\n", mRunIndex, mEvents, mOverflowed ? 1 : 0);
+            std::fflush(mFile);
+        }
+        mActive = false;
+        ++mRunIndex;
+        if (completedCapture && mExitWhenComplete) {
+            std::_Exit(EXIT_SUCCESS);
+        }
+    }
+
+    bool beginEvent() {
+        if (!active() || mFile == nullptr) {
+            return false;
+        }
+        if (mEvents++ >= mMaximumEvents) {
+            mOverflowed = true;
+            std::fprintf(mFile, "overflow|%ld|%zu\n", mRunIndex, mEvents - 1);
+            return false;
+        }
+        return true;
+    }
+
+    template <typename... Args> void line(const char* format, Args... args) {
+        if (!beginEvent()) {
+            return;
+        }
+        std::fprintf(mFile, format, args...);
+    }
+
+    template <typename... Args> void raw(const char* format, Args... args) {
+        if (!active() || mFile == nullptr) {
+            return;
+        }
+        std::fprintf(mFile, format, args...);
+    }
+
+    void nextCommand() {
+        ++mCommandIndex;
+    }
+
+    void captureFramebuffers(GfxRenderingAPI* renderingApi, int frameBuffer, uint32_t width, uint32_t height) {
+        if (!active() || width == 0 || height == 0) {
+            return;
+        }
+
+        if (!mColorPath.empty()) {
+            std::vector<uint16_t> rgba(width * height);
+            renderingApi->ReadFramebufferToCPU(frameBuffer, width, height, rgba.data());
+            FILE* image = std::fopen(mColorPath.c_str(), "wb");
+            if (image == nullptr) {
+                std::fprintf(stderr, "Unable to open OOT_FAST3D_COLOR_CAPTURE '%s': %s\n", mColorPath.c_str(),
+                             std::strerror(errno));
+            } else {
+                std::fprintf(image, "P6\n%u %u\n255\n", width, height);
+                for (uint16_t pixel : rgba) {
+                    uint8_t red = (pixel >> 11) & 0x1f;
+                    uint8_t green = (pixel >> 6) & 0x1f;
+                    uint8_t blue = (pixel >> 1) & 0x1f;
+                    std::fputc((red << 3) | (red >> 2), image);
+                    std::fputc((green << 3) | (green >> 2), image);
+                    std::fputc((blue << 3) | (blue >> 2), image);
+                }
+                std::fclose(image);
+            }
+        }
+
+        if (!mDepthPath.empty()) {
+            std::vector<float> depth(width * height);
+            if (!renderingApi->ReadFramebufferDepthToCPU(frameBuffer, width, height, depth.data())) {
+                std::fprintf(stderr, "The selected graphics backend cannot capture depth\n");
+                return;
+            }
+            FILE* depthFile = std::fopen(mDepthPath.c_str(), "wb");
+            if (depthFile == nullptr) {
+                std::fprintf(stderr, "Unable to open OOT_FAST3D_DEPTH_CAPTURE '%s': %s\n", mDepthPath.c_str(),
+                             std::strerror(errno));
+                return;
+            }
+            std::fwrite(depth.data(), sizeof(float), depth.size(), depthFile);
+            std::fclose(depthFile);
+        }
+    }
+
+  private:
+    FILE* mFile = nullptr;
+    long mFirstFrame = 0;
+    long mFrameCount = 1;
+    long mRunIndex = 0;
+    int mCommandIndex = -1;
+    size_t mMaximumEvents = DefaultMaximumEvents;
+    size_t mEvents = 0;
+    bool mActive = false;
+    bool mOverflowed = false;
+    bool mExitWhenComplete = false;
+    std::string mColorPath;
+    std::string mDepthPath;
+};
+
+Writer& Trace() {
+    static Writer writer;
+    return writer;
+}
+
+void WriteMatrix(Writer& writer, const float matrix[4][4]) {
+    for (int row = 0; row < 4; ++row) {
+        for (int column = 0; column < 4; ++column) {
+            writer.raw("%s%08x", row == 0 && column == 0 ? "" : ",", std::bit_cast<uint32_t>(matrix[row][column]));
+        }
+    }
+}
+
+} // namespace
+
+void ReferenceTraceBeginRun(Interpreter* interpreter) {
+    Trace().beginRun(interpreter->mInterpolationT, interpreter->mInterpolationIndex);
+    ReferenceTraceOperation(interpreter, "clear-target", 0, 1, 1);
+    ReferenceTraceState(interpreter);
+}
+
+void ReferenceTraceEndRun(Interpreter*) {
+    Trace().endRun();
+}
+
+void ReferenceTraceCommand(Interpreter*, const F3DGfx* command, uint32_t microcode, size_t stackDepth) {
+    Writer& writer = Trace();
+    if (!writer.active()) {
+        return;
+    }
+    writer.nextCommand();
+    writer.line("command|%d|%u|%zu|%08x|%016llx\n", writer.commandIndex(), microcode, stackDepth,
+                static_cast<uint32_t>(command->words.w0), static_cast<unsigned long long>(command->words.w1));
+}
+
+void ReferenceTraceResource(Interpreter*, uint8_t opcode, const char* path) {
+    Writer& writer = Trace();
+    writer.line("resource|%d|%u|%s\n", writer.commandIndex(), opcode, path == nullptr ? "" : path);
+}
+
+void ReferenceTraceState(Interpreter* interpreter) {
+    Writer& writer = Trace();
+    if (!writer.active() || interpreter == nullptr) {
+        return;
+    }
+    const RSP& rsp = *interpreter->mRsp;
+    const RDP& rdp = *interpreter->mRdp;
+    if (!writer.beginEvent()) {
+        return;
+    }
+    writer.raw(
+        "state|%d|%08x|%08x|%08x|%08x|%016llx|%08x|%u|%08x|%08x|%08x|%d|%d|%08x|%08x|%u|%d|%08x|%d|%d|%u|%u|%d,%d,%u,%u|%d,%d,%u,%u|",
+        writer.commandIndex(), rsp.geometry_mode, rsp.extra_geometry_mode, rdp.other_mode_h, rdp.other_mode_l,
+        static_cast<unsigned long long>(rdp.combine_mode), PackColor(rdp.prim_color), rdp.prim_lod_fraction,
+        PackColor(rdp.env_color), PackColor(rdp.key_center), PackColor(rdp.key_scale), rdp.convert_k[4], rdp.convert_k[5],
+        PackColor(rdp.fog_color), PackColor(rdp.blend_color), rdp.prim_depth, rdp.grayscale ? 1 : 0,
+        PackColor(rdp.grayscale_color), rsp.fog_mul, rsp.fog_offset, rdp.first_tile_index, rsp.texture_scaling_factor.s,
+        rdp.viewport.x, rdp.viewport.y, rdp.viewport.width, rdp.viewport.height, rdp.scissor.x, rdp.scissor.y,
+        rdp.scissor.width, rdp.scissor.height);
+    for (size_t index = 0; index < 8; ++index) {
+        const auto& tile = rdp.texture_tile[index];
+        writer.raw("%s%08x,%08x,%08x,%08x,%u,%u,%u,%u,%u,%u,%u,%u,%u,%u,%u,%u", index == 0 ? "" : ";",
+                   std::bit_cast<uint32_t>(tile.uls), std::bit_cast<uint32_t>(tile.ult),
+                   std::bit_cast<uint32_t>(tile.lrs), std::bit_cast<uint32_t>(tile.lrt), tile.fmt, tile.siz,
+                   tile.line_size_bytes, tile.tmem, tile.palette, tile.cms, tile.cmt, tile.masks, tile.maskt,
+                   tile.shifts, tile.shiftt, tile.tmem_index);
+    }
+    writer.raw("|");
+    WriteMatrix(writer, rsp.P_matrix);
+    writer.raw("|");
+    const size_t modelViewIndex = rsp.modelview_matrix_stack_size == 0 ? 0 : rsp.modelview_matrix_stack_size - 1;
+    WriteMatrix(writer, rsp.modelview_matrix_stack[modelViewIndex]);
+    writer.raw("\n");
+}
+
+void ReferenceTraceVertex(Interpreter*, size_t index, const LoadedVertex& vertex) {
+    Writer& writer = Trace();
+    writer.line("vertex|%d|%zu|%08x,%08x,%08x,%08x,%08x,%08x,%u,%u,%u,%u,%u\n", writer.commandIndex(), index,
+                std::bit_cast<uint32_t>(vertex.x), std::bit_cast<uint32_t>(vertex.y),
+                std::bit_cast<uint32_t>(vertex.z), std::bit_cast<uint32_t>(vertex.w),
+                std::bit_cast<uint32_t>(vertex.u), std::bit_cast<uint32_t>(vertex.v), vertex.color.r, vertex.color.g,
+                vertex.color.b, vertex.color.a, vertex.clip_rej);
+}
+
+void ReferenceTraceTriangle(Interpreter*, uint8_t first, uint8_t second, uint8_t third, const char* disposition) {
+    Writer& writer = Trace();
+    writer.line("triangle|%d|%u|%u|%u|%s\n", writer.commandIndex(), first, second, third, disposition);
+}
+
+void ReferenceTraceGeometry(Interpreter*, const float* vertices, size_t floatCount) {
+    Writer& writer = Trace();
+    if (!writer.active() || !writer.beginEvent()) {
+        return;
+    }
+    writer.raw("geometry|%d|", writer.commandIndex());
+    for (size_t index = 0; index < floatCount; ++index) {
+        writer.raw("%s%08x", index == 0 ? "" : ",", std::bit_cast<uint32_t>(vertices[index]));
+    }
+    writer.raw("\n");
+}
+
+void ReferenceTraceFramebuffers(GfxRenderingAPI* renderingApi, int frameBuffer, uint32_t width, uint32_t height) {
+    Trace().captureFramebuffers(renderingApi, frameBuffer, width, height);
+}
+
+void ReferenceTraceDraw(Interpreter*, const float* vertices, size_t floatCount, size_t triangleCount) {
+    Writer& writer = Trace();
+    if (!writer.active()) {
+        return;
+    }
+    if (!writer.beginEvent()) {
+        return;
+    }
+    writer.raw("draw|%d|%zu|%zu|", writer.commandIndex(), floatCount, triangleCount);
+    for (size_t index = 0; index < floatCount; ++index) {
+        writer.raw("%s%08x", index == 0 ? "" : ",", std::bit_cast<uint32_t>(vertices[index]));
+    }
+    writer.raw("\n");
+}
+
+void ReferenceTraceOperation(Interpreter*, const char* operation, int first, int second, int third, int fourth) {
+    Writer& writer = Trace();
+    writer.line("operation|%d|%s|%d|%d|%d|%d\n", writer.commandIndex(), operation, first, second, third, fourth);
+}
+
+} // namespace Fast
