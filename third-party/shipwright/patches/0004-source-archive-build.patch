Subject: Build native asset tools from pinned source archives.

Upstream-Status: Zoot build integration. No guest source changes.

diff --git a/CMakeLists.txt b/CMakeLists.txt
index a0a23e1..f7620b9 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -7,6 +7,9 @@ set(CMAKE_C_STANDARD 23 CACHE STRING "The C standard to use")
 set(CMAKE_OSX_DEPLOYMENT_TARGET "10.15" CACHE STRING "Minimum OS X deployment version")
 
 project(Ship VERSION 9.2.3 LANGUAGES C CXX)
+if(DEFINED ZOOT_DEPENDENCY_RECIPE)
+    include("${ZOOT_DEPENDENCY_RECIPE}/native-dependencies.cmake")
+endif()
 include(CMake/soh-cvars.cmake)
 include(CMake/lus-cvars.cmake)
 set(SPDLOG_LEVEL_TRACE 0)
@@ -42,6 +45,12 @@ list(GET NATO_PHONETIC_ALPHABET ${PATCH_INDEX} PROJECT_PATCH_WORD)
 set(PROJECT_BUILD_NAME "Ackbar ${PROJECT_PATCH_WORD}" CACHE STRING "" FORCE)
 set(PROJECT_TEAM "github.com/harbourmasters" CACHE STRING "" FORCE)
 
+if(DEFINED ZOOT_DEPENDENCY_RECIPE)
+set(CMAKE_PROJECT_GIT_BRANCH "zoot" CACHE STRING "Git branch" FORCE)
+string(SUBSTRING "${ZOOT_SHIPWRIGHT_REVISION}" 0 7 SHORT_COMMIT_HASH)
+set(CMAKE_PROJECT_GIT_COMMIT_HASH "${SHORT_COMMIT_HASH}" CACHE STRING "Git commit hash" FORCE)
+set(CMAKE_PROJECT_GIT_COMMIT_TAG "" CACHE STRING "Git commit tag" FORCE)
+else()
 execute_process(
     COMMAND git branch --show-current
     WORKING_DIRECTORY ${CMAKE_SOURCE_DIR}
@@ -75,6 +84,7 @@ if(NOT GIT_COMMIT_TAG)
 endif()
 
 set(CMAKE_PROJECT_GIT_COMMIT_TAG "${GIT_COMMIT_TAG}" CACHE STRING "Git commit tag" FORCE)
+endif()
 
 set_property(DIRECTORY ${CMAKE_SOURCE_DIR} PROPERTY VS_STARTUP_PROJECT soh)
 add_compile_options($<$<CXX_COMPILER_ID:MSVC>:/MP>)
